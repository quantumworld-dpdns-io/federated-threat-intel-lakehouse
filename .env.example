# Application
APP_NAME=federated-threat-intel-lakehouse
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Authentication
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Iceberg Catalog
ICEBERG_CATALOG_TYPE=rest
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_CATALOG_WAREHOUSE=s3://threat-intel-lakehouse/warehouse
ICEBERG_S3_ENDPOINT=http://localhost:9000
ICEBERG_S3_ACCESS_KEY=minioadmin
ICEBERG_S3_SECRET_KEY=minioadmin

# Trino
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=threat_intel

# DuckDB
DUCKDB_PATH=local.duckdb

# DragonflyDB / Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Chroma (Vector DB - Dev)
CHROMA_HOST=localhost
CHROMA_PORT=8500
CHROMA_COLLECTION=threat_intel

# Milvus (Vector DB - Production)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=threat_intel

# Weaviate
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_URL=http://localhost:8080

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# IBM Quantum (for Qiskit)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_BACKEND=ibm_brisbane

# NVIDIA CUDA-Q
CUDAQ_ENABLED=false

# Post-Quantum Crypto
PQC_ENABLED=true
PQC_DEFAULT_ALGORITHM=CRYSTALS-Kyber-768

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=federated-threat-intel-lakehouse
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# Arize Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Federated Learning
FL_NUM_ROUNDS=10
FL_MIN_CLIENTS=3
FL_FRACTION_FIT=0.5
FL_STRATEGY=fedavg
FL_PRIVACY_EPSILON=8.0
FL_PRIVACY_DELTA=1e-5
FL_GRADIENT_CLIP=1.0

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=threat-intel-lakehouse

# Security
OWASP_ZAP_HOST=localhost
OWASP_ZAP_PORT=8090
OWASP_ZAP_API_KEY=
